# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/prompt_analyzer

# Auth (IMPORTANT: This secret is used for API Key encryption - keep it safe!)
BETTER_AUTH_SECRET=your-better-auth-secret-here
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,https://your-domain.vercel.app
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=your-cloudflare-account-id
# Optional. If set, overrides R2_ACCOUNT_ID endpoint construction.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
# Use your R2 custom domain or public dev URL, without a trailing slash.
R2_PUBLIC_URL=https://cdn.your-domain.com

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin
ADMIN_EMAILS=admin@example.com,your-email@gmail.com

# AI Providers (System-wide keys - optional, users can provide their own)
# Provider definitions live in config/ai-providers.json - see docs/ai-providers.md
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENAI_API_KEY=your-openai-api-key
ZHIPU_API_KEY=your-zhipu-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# AI Provider routing (optional)
# Default provider when nothing is switched at runtime (fallback: config defaultProvider)
# AI_ACTIVE_PROVIDER=openrouter
# Inline JSON overlay merged into config/ai-providers.json (same id overrides, new id appends)
# AI_PROVIDERS_CONFIG={"defaultProvider":"anthropic","providers":[{"id":"gateway","protocol":"openai-chat","baseUrl":"https://llm.internal/v1","apiKeyEnv":["GATEWAY_KEY"]}]}
# Per-provider overrides: AI_PROVIDER_<ID>_BASE_URL|MODEL|PATH|PROTOCOL|API_KEY|API_KEY_ENV|TIMEOUT_MS|ENABLED
# AI_PROVIDER_OPENAI_BASE_URL=https://gateway.example.com/v1
# AI_PROVIDER_OPENAI_MODEL=gpt-4.1-mini
# AI_PROVIDER_KIE_BASE_URL=https://api.kie.ai
# Fixed provider for video-edit instruction parsing (defaults to the active provider)
# VIDEO_EDIT_PROVIDER=deepseek

# Online provider config cache (database overrides picked up by other instances)
# Default 2000ms. Set 0 to read the database on every request.
# AI_CONFIG_CACHE_MS=2000

# Audio Transcription (AssemblyAI - Free 1 hour/month)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
# ASSEMBLYAI_BASE_URL=https://api.assemblyai.com

# Video Generation (Kie.ai / Wan)
KIE_API_KEY=your-kie-api-key
KIE_API_BASE_URL=https://api.kie.ai
KIE_VIDEO_MODEL=wan/2-7-text-to-video

# Video Editing (Shotstack - Free 7200s/month)
SHOTSTACK_API_KEY_ID=your-shotstack-key-id
SHOTSTACK_API_SECRET=your-shotstack-secret
